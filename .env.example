# Configuration passed to the app with `--dart-define-from-file=.env`
# (`make setup` copies this file to `.env` when it does not exist yet).
# Values are compiled into the build, so keep secrets out of this file.
#
# SQLite database file opened by the local drift database.
# Relative paths resolve against the working directory of the process; the
# parent directory must exist and be writable. The `-wal` and `-shm` files
# SQLite creates next to it are runtime-only and must stay out of version control.
# Reserved for the domain build: the foundation opens no database.
DATABASE_PATH=data/app.db

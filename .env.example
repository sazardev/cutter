# Configuration passed to the app with `--dart-define-from-file=.env`
# (`make setup` copies this file to `.env` when it does not exist yet).
# Values are compiled into the build, so keep secrets out of this file.
#
# SQLite database file opened by the local drift database.
#
# A relative path resolves against the platform's app-data directory, the
# only place a phone lets the app write to, so the same value works on a
# device and on a desktop. An absolute path is taken as it is, which is what
# the container deployment of STACK.md needs; the directory has to exist and
# be writable.
#
# The `-wal` and `-shm` files SQLite creates next to the database are
# runtime-only and must stay out of version control.
DATABASE_PATH=data/app.db

# Where the music library reads its catalog of packs. Leave it out to use the
# release the `Music packs` workflow publishes; set it to try packs of your
# own (tool/music_packs/README.md).
# MUSIC_CATALOG_URL=http://127.0.0.1:8099/out/catalog.json

  "fixed_sql": [
    {
      "name": "editor_projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"canvas_width\" INTEGER NOT NULL CHECK(\"canvas_width\" > 0), \"canvas_height\" INTEGER NOT NULL CHECK(\"canvas_height\" > 0), \"fps\" INTEGER NOT NULL CHECK(\"fps\" > 0), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_layers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_layers\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL CHECK(\"position\" >= 0), \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('video', 'image', 'audio')), \"volume\" REAL NOT NULL DEFAULT 1.0, \"muted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"muted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_clips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_clips\" (\"id\" TEXT NOT NULL, \"layer_id\" TEXT NOT NULL, \"sort_key\" INTEGER NOT NULL, \"source_uri\" TEXT NOT NULL, \"start_ms\" INTEGER NOT NULL CHECK(\"start_ms\" >= 0), \"duration_ms\" INTEGER NOT NULL CHECK(\"duration_ms\" > 0), \"in_point_ms\" INTEGER NOT NULL CHECK(\"in_point_ms\" >= 0), \"out_point_ms\" INTEGER NOT NULL CHECK(\"out_point_ms\" > 0), \"reversed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reversed\" IN (0, 1)), \"volume\" REAL NOT NULL DEFAULT 1.0, \"filter_id\" TEXT NULL, \"adjustments_json\" TEXT NOT NULL DEFAULT '{}', \"source_duration_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]

  "fixed_sql": [
    {
      "name": "editor_projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, \"canvas_width\" INTEGER NOT NULL CHECK(\"canvas_width\" > 0), \"canvas_height\" INTEGER NOT NULL CHECK(\"canvas_height\" > 0), \"fps\" INTEGER NOT NULL CHECK(\"fps\" > 0), \"saved_at_ms\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_layers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_layers\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL CHECK(\"position\" >= 0), \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('video', 'image', 'audio', 'text')), \"volume\" REAL NOT NULL DEFAULT 1.0, \"muted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"muted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_clips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_clips\" (\"id\" TEXT NOT NULL, \"layer_id\" TEXT NOT NULL, \"sort_key\" INTEGER NOT NULL, \"source_uri\" TEXT NOT NULL, \"start_ms\" INTEGER NOT NULL CHECK(\"start_ms\" >= 0), \"duration_ms\" INTEGER NOT NULL CHECK(\"duration_ms\" > 0), \"in_point_ms\" INTEGER NOT NULL CHECK(\"in_point_ms\" >= 0), \"out_point_ms\" INTEGER NOT NULL CHECK(\"out_point_ms\" > 0), \"reversed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reversed\" IN (0, 1)), \"volume\" REAL NOT NULL DEFAULT 1.0, \"filter_id\" TEXT NULL, \"adjustments_json\" TEXT NOT NULL DEFAULT '{}', \"source_duration_ms\" INTEGER NULL, \"pos_x\" REAL NOT NULL DEFAULT 0.0, \"pos_y\" REAL NOT NULL DEFAULT 0.0, \"scale\" REAL NOT NULL DEFAULT 1.0, \"rotation\" REAL NOT NULL DEFAULT 0.0, \"opacity\" REAL NOT NULL DEFAULT 1.0, \"flip_x\" INTEGER NOT NULL DEFAULT 0 CHECK (\"flip_x\" IN (0, 1)), \"fit\" TEXT NOT NULL DEFAULT 'fit' CHECK(\"fit\" IN ('fit', 'fill')), \"source_width\" INTEGER NOT NULL DEFAULT 0, \"source_height\" INTEGER NOT NULL DEFAULT 0, \"crop_left\" REAL NOT NULL DEFAULT 0.0, \"crop_top\" REAL NOT NULL DEFAULT 0.0, \"crop_right\" REAL NOT NULL DEFAULT 0.0, \"crop_bottom\" REAL NOT NULL DEFAULT 0.0, \"speed\" REAL NOT NULL DEFAULT 1.0, \"fade_in_ms\" INTEGER NOT NULL DEFAULT 0, \"fade_out_ms\" INTEGER NOT NULL DEFAULT 0, \"text_json\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_versions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_versions\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"snapshot_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_exports",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_exports\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NULL, \"project_name\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"fps\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"created_at_ms\" INTEGER NOT NULL, \"preset\" TEXT NOT NULL, \"in_gallery\" INTEGER NOT NULL DEFAULT 0 CHECK (\"in_gallery\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "editor_media",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"editor_media\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NULL, \"path\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('video', 'image', 'audio')), \"duration_ms\" INTEGER NOT NULL, \"width\" INTEGER NOT NULL DEFAULT 0, \"height\" INTEGER NOT NULL DEFAULT 0, \"has_audio\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_audio\" IN (0, 1)), \"size_bytes\" INTEGER NOT NULL DEFAULT 0, \"added_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"project_id\", \"path\"));"
        }
      ]
    },
